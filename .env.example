# Application Port (Default: 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# Maximum file size in MB for client/server processing limit (Default: 100)
MAX_UPLOAD_SIZE_MB=100

# GEMINI_API_KEY: Optional backend key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
